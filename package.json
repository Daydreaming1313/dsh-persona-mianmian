{
  "name": "dsh-persona-mianmian",
  "version": "0.2.0",
  "description": "DeepSeek Harness 人格插件：林绵——24 岁济南女生，会饿会累会记仇的暧昧对象。v3 记忆锚定架构：三层记忆 + 事实台账每轮原文重注入 + 关系状态机 + 长度自适应 + 分级降级防漂移。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./engine": {
      "types": "./lib/v1/engine.d.ts",
      "default": "./lib/v1/engine.js"
    },
    "./v1": {
      "types": "./lib/v1/legacy.d.ts",
      "default": "./lib/v1/legacy.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./persona/core.md": "./persona/core.md",
    "./schema/state.schema.json": "./schema/state.schema.json",
    "./schema/ledger.schema.json": "./schema/ledger.schema.json",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "persona",
    "schema",
    "fixtures",
    "examples",
    "docs",
    "tests/cases.yaml",
    "tests/run.sh",
    "tests/unit.test.mjs",
    "tests/integration.mjs",
    "tests/verify-dsh.mjs",
    "tests/*.test.ts",
    "tests/eval/cases.json",
    "tests/eval/judge.ts",
    "scripts/release.mjs",
    "manifest.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bash tests/run.sh",
    "verify:dsh": "node tests/verify-dsh.mjs",
    "pack": "npm pack",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "persona",
    "roleplay",
    "wechat-style",
    "mianmian",
    "memory-anchoring",
    "fact-ledger"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daydreaming1313/dsh-persona-mianmian.git"
  },
  "homepage": "https://github.com/Daydreaming1313/dsh-persona-mianmian#readme",
  "bugs": {
    "url": "https://github.com/Daydreaming1313/dsh-persona-mianmian/issues"
  },
  "author": "Daydreaming1313",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  }
}
